# hw-revA-node2: Cudy WR3000P second bench node, PoE powered. ADR 0007. Same package set as hw-revA.
OPENWRT_RELEASE=24.10.5
OPENWRT_TARGET=mediatek/filogic
IB_PROFILE=cudy_wr3000p-v1
PACKAGES="-luci -luci-ssl -uhttpd -uhttpd-mod-ubus -dnsmasq -odhcpd-ipv6only -ppp -ppp-mod-pppoe -firewall4 -nftables -kmod-nft-offload \
 -wpad-basic-mbedtls wpad-mbedtls kmod-mt7915e kmod-mt7981-firmware \
 dropbear usign kmod-i2c-core kmod-i2c-gpio kmod-eeprom-at24 i2c-tools gpiod-tools \
 iwinfo iw-full ethtool-full curl ca-bundle"
