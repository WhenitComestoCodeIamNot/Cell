#!/bin/sh /etc/rc.common
# Cell agent: reads DIP, decides Seed/Node role, runs join window, applies config.
START=95
USE_PROCD=1
start_service() {
  procd_open_instance
  procd_set_param command /usr/sbin/cell-agent run
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
